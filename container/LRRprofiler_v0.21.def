Bootstrap: docker
From: debian:bookworm-slim

%labels
    Maintainer "Johanna Girodolle"
    Authors "Celine Gottin, Vincent Ranwez"
    Description "LRRprofiler with pinned iTAK and Pixi-managed dependencies"
    LRRprofilerCommit d6dfa4c6b710145881744d096c9cd389c1dffe9f
    iTAKCommit 1356651e73ab3b7e70f234b8d624b76c103a63ed
    TMHMMVersion 2.0c

%files
    pixi.toml /opt/pixi/pixi.toml
    pixi.lock /opt/pixi/pixi.lock
    tmhmm2.0c-linux.tar /opt/tmhmm2.0c-linux.tar

%post
    set -eu

    # Install prerequisites for Pixi and Git repositories.
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends bash ca-certificates curl git
    rm -rf /var/lib/apt/lists/*

    # Install reproducible scientific dependencies.
    curl -fsSL https://pixi.sh/install.sh -o /tmp/install-pixi.sh
    PIXI_VERSION=0.81.0 PIXI_NO_PATH_UPDATE=1 sh /tmp/install-pixi.sh
    rm /tmp/install-pixi.sh
    export PATH="/root/.pixi/bin:/opt/pixi/.pixi/envs/default/bin:$PATH"
    cd /opt/pixi
    pixi install --locked

    # Fetch exact versions of LRRprofiler and legacy Perl iTAK.
    git clone https://github.com/ranwez/LRRprofiler.git /opt/LRRprofiler
    git -C /opt/LRRprofiler checkout --detach d6dfa4c6b710145881744d096c9cd389c1dffe9f
    git clone https://github.com/kentnf/iTAK.git /opt/iTAK
    git -C /opt/iTAK checkout --detach 1356651e73ab3b7e70f234b8d624b76c103a63ed
    chmod +x /opt/LRRprofiler/src/*.sh
    chmod +x /opt/iTAK/bin/hmmscan /opt/iTAK/bin/hmmpress

    # Initialize iTAK's HMM databases while its installation is writable.
    mkdir -p /opt/itak-test
    cp /opt/iTAK/test_seq /opt/itak-test/test_seq
    cd /opt/itak-test
    perl /opt/iTAK/iTAK.pl -p 1 test_seq
    test -f test_seq_output/shiu_alignment.txt
    cd /
    rm -rf /opt/itak-test /opt/LRRprofiler/.git /opt/iTAK/.git

    # Install the locally extracted TMHMM 2.0c distribution.
    # The source SIF must contain the Linux x86-64 decoder.
    tar -xf /opt/tmhmm2.0c-linux.tar -C /
    rm /opt/tmhmm2.0c-linux.tar
    test -f /tmhmm2.0c/bin/tmhmm
    test -f /tmhmm2.0c/bin/decodeanhmm.Linux_x86_64
    chmod +x /tmhmm2.0c/bin/tmhmm /tmhmm2.0c/bin/decodeanhmm.Linux_x86_64
    ln -s /opt/pixi/.pixi/envs/default/bin/perl /usr/local/bin/perl

%environment
    export PATH="/opt/pixi/.pixi/envs/default/bin:$PATH"
    export LC_ALL=C
    export LG_SCRIPT="/opt/LRRprofiler/src"
    export LG_HMMlib="/opt/LRRprofiler/HMM_lib"
    export LG_MAFFT="mafft"
    export LG_ITAK="/opt/iTAK/iTAK.pl"
    export LG_TMHMM="/tmhmm2.0c/bin/tmhmm"

%runscript
    exec bash /opt/LRRprofiler/src/LRRprofiler_global.sh "$@"

%test
    set -eu
    export PATH="/opt/pixi/.pixi/envs/default/bin:$PATH"
    for executable in python3 perl gawk hmmsearch hmmbuild mafft blastp makeblastdb Rscript pandoc; do
        command -v "$executable" > /dev/null
    done
    python3 -c 'from Bio import SearchIO, SeqIO'
    perl -MBio::SeqIO -e 1
    Rscript -e 'library(rmarkdown); library(ggplot2); library(reshape2)'
    test -s /opt/iTAK/database/Plant_Pkinase_fam.hmm.h3i
    # Verify that TMHMM produces two helices for a known protein.
    tmhmm_output=$(
        printf '>TM_TEST\nMEILCEDNTSLSSIPNSLMQVDGDSGLYRNDFNSRDANSSDASNWTIDGENRTNLSFEGYLPPTCLSILHL\nQEKNWSALLTAVVIILTIAGNILVIMAVSLEKKLQNATNYFLMSLAIADMLLGFLVMPVSMLTILYGYRWP\n' |
            /tmhmm2.0c/bin/tmhmm -noplot -d
    )
    printf '%s\n' "$tmhmm_output"
    printf '%s\n' "$tmhmm_output" |
        gawk '$1 == "TM_TEST" && $3 == "TMhelix" { n++ } END { exit (n != 2) }'
